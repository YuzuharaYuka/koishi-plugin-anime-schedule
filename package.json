    "readme.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuzuharaYuka/koishi-plugin-anime-schedule.git"
  },
  "homepage": "https://github.com/YuzuharaYuka/koishi-plugin-anime-schedule#readme",
  "bugs": {
    "url": "https://github.com/YuzuharaYuka/koishi-plugin-anime-schedule/issues"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "anime",
    "bangumi",
    "bangumi-data",
    "anilist",
    "schedule",
    "calendar",
    "subscription"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "bangumi-data": "^0.3.235"
  },
  "koishi": {
    "description": {
      "zh": "番剧更新表与订阅提醒，提供日、周、季三张表，支持定时推送、订阅、搜索与详情。"
